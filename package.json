{
  "name": "dsh-bz",
  "version": "1.0.1",
  "description": "Zero-dependency rule injector for DeepSeek Harness: three-scope rules (global/project/session) published as system-reminder at conversation start, with loop-breaker, dedupe, session persistence, /bz commands, and a settings-panel editor.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mzgnk/dsh-bz.git"
  },
  "homepage": "https://github.com/Mzgnk/dsh-bz#readme",
  "bugs": {
    "url": "https://github.com/Mzgnk/dsh-bz/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rules",
    "system-reminder",
    "loop-breaker",
    "zero-dependency"
  ]
}
